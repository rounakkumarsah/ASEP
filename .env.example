# =============================================================================
# ASEP — Autonomous Software Engineering Platform  v0.1.3
# Environment Variables Template — COMPLETE
# =============================================================================
# Usage:
#   cp .env.example .env
#   nano .env          # fill in all REQUIRED values
#
# Sections:
#   1.  Application
#   2.  Domain & TLS (production)
#   3.  PostgreSQL
#   4.  Redis
#   5.  Neo4j
#   6.  Qdrant
#   7.  LLM Providers (AI)
#   8.  Ollama (local LLM — self-hosted)
#   9.  Security & JWT
#   10. CORS
#   11. Cloudflare Turnstile (bot protection)
#   12. GitHub OAuth
#   13. Google OAuth
#   14. Razorpay (payments)
#   15. Email / SMTP / Resend
#   16. Multi-Factor Authentication (TOTP)
#   17. Cloudinary (file storage)
#   18. PostHog (analytics)
#   19. Sentry (error tracking)
#   20. Policy Governance Engine
#   21. Agent Sandbox (Docker)
#   22. Frontend (Next.js public vars)
#   23. E2E Testing
#   24. Infrastructure monitoring
#
# NEVER commit this file with real values filled in.
# Generate secrets with: openssl rand -hex 32

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development                  # development | staging | production
APP_NAME=ASEP
APP_VERSION=0.1.0
APP_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true                      # Hot-reload (dev only)
APP_WORKERS=1                        # Uvicorn workers (production: set to CPU count)

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=asep
POSTGRES_USER=asep
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://asep:changeme@localhost:5432/asep

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
REDIS_TERMINAL_CHANNEL_PREFIX=opensep:terminal

# ---------------------------------------------------------------------------
# Neo4j
# ---------------------------------------------------------------------------
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_URI=bolt://localhost:7687

# ---------------------------------------------------------------------------
# Qdrant
# ---------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ---------------------------------------------------------------------------
# Ollama
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# ---------------------------------------------------------------------------
# AI LLM Provider API Keys & Settings
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Open Policy Agent (OPA) Guardrails
# ---------------------------------------------------------------------------
OPA_ENABLED=false
OPA_URL=http://localhost:8181/v1/data/asep/policy

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-random-256-bit-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (bot protection)
# ---------------------------------------------------------------------------
# Get your keys at: https://dash.cloudflare.com/?to=/:account/turnstile
# In development the Cloudflare always-pass test keys are used automatically.
ENABLE_TURNSTILE=false
NEXT_PUBLIC_ENABLE_TURNSTILE=false
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# GitHub OAuth (Social Login)
# ---------------------------------------------------------------------------
# Create an OAuth App at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:8000/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/github/callback

# ---------------------------------------------------------------------------
# Google OAuth (Social Login)
# ---------------------------------------------------------------------------
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# Frontend URL for OAuth redirect after callback
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# ---------------------------------------------------------------------------
# Razorpay (Payments)
# ---------------------------------------------------------------------------
# Test mode keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Email / SMTP
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@asep.local
RESEND_API_KEY=                               # Get from: https://resend.com
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# 2. Domain & TLS (production only)
# ---------------------------------------------------------------------------
DOMAIN=asep.yourdomain.com                   # Your production domain
ACME_EMAIL=admin@yourdomain.com              # For Let's Encrypt TLS certificates
APP_VERSION=0.1.3

# ---------------------------------------------------------------------------
# 16. Multi-Factor Authentication (TOTP / MFA)
# ---------------------------------------------------------------------------
MFA_ISSUER_NAME=ASEP                         # Displayed in authenticator apps (e.g. Google Auth)
MFA_BACKUP_CODE_COUNT=8                      # Number of one-time backup codes generated

# ---------------------------------------------------------------------------
# 17. Cloudinary (file/avatar storage)
# ---------------------------------------------------------------------------
# Get from: https://cloudinary.com/console
# Set CLOUDINARY_URL OR the individual values (not both)
CLOUDINARY_URL=                              # e.g. cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# 18. PostHog (product analytics)
# ---------------------------------------------------------------------------
# Get from: https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=                     # phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ---------------------------------------------------------------------------
# 19. Sentry (error tracking)
# ---------------------------------------------------------------------------
# Get from: https://sentry.io/settings/projects/
SENTRY_DSN=                                  # https://xxx@xxx.ingest.sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=                      # Same DSN for frontend (or separate project)
SENTRY_ENVIRONMENT=development               # development | staging | production
SENTRY_RELEASE=${APP_VERSION:-0.1.3}

# ---------------------------------------------------------------------------
# 7. LLM Providers — AI Keys
# ---------------------------------------------------------------------------
# Google Gemini (primary)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=                              # REQUIRED for agent functionality

# Anthropic Claude (secondary / fallback)
ANTHROPIC_API_KEY=                           # Already in file above (kept here for reference)

# OpenAI (optional — for embeddings or fallback)
OPENAI_API_KEY=

# Cohere (optional — for reranking)
COHERE_API_KEY=

# Default LLM provider selection
LLM_DEFAULT_PROVIDER=gemini                  # gemini | anthropic | openai | ollama
LLM_DEFAULT_MODEL=gemini-1.5-pro             # Model name for selected provider
LLM_TEMPERATURE=0.1                          # 0.0–1.0; lower = more deterministic
LLM_MAX_TOKENS=8192                          # Max output tokens per LLM call

# ---------------------------------------------------------------------------
# 21. Agent Sandbox (Docker)
# ---------------------------------------------------------------------------
SANDBOX_IMAGE=ubuntu:22.04                   # Base Docker image for agent sandboxes
SANDBOX_CPU_LIMIT=0.5                        # CPU cores per sandbox (float)
SANDBOX_MEMORY_LIMIT=512m                    # Memory per sandbox (Docker units)
SANDBOX_TIMEOUT_SECONDS=300                  # Max execution time per sandbox (5 minutes)
SANDBOX_NETWORK_MODE=none                    # none | bridge (none = no internet access)
SANDBOX_MAX_CONCURRENT=10                    # Max simultaneous sandboxes

# ---------------------------------------------------------------------------
# 22. Frontend (Next.js Public Variables)
# ---------------------------------------------------------------------------
# These are exposed to the browser — do NOT put secrets here
NEXT_PUBLIC_API_URL=http://localhost:8000    # Backend API base URL (no /api suffix)
NEXT_PUBLIC_WS_URL=ws://localhost:8000       # WebSocket URL
NEXT_PUBLIC_APP_NAME=ASEP
NEXT_PUBLIC_APP_VERSION=0.1.3
NEXT_PUBLIC_ENABLE_TURNSTILE=false           # Already in file; repeated here for clarity

# ---------------------------------------------------------------------------
# 23. E2E Testing (Playwright)
# ---------------------------------------------------------------------------
# These values are used ONLY during automated E2E test runs
# They correspond to the seed user created by POST /api/v1/auth/e2e/seed-user
E2E_USER_EMAIL=e2e-test@asep.local
E2E_USER_PASSWORD=E2eTestPassword123!
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# 24. Infrastructure & Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_LOGIN_MAX=5                       # Failed login attempts before lockout
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900          # Lockout window (15 minutes)
RATE_LIMIT_REGISTER_MAX=3                    # Registrations per IP per hour
RATE_LIMIT_API_MAX=100                       # Generic API requests per minute per user
