# ASEP Backend Environment Configuration
# Copy this file to .env for local development

# --------------------------------------------------
# Application Settings
# --------------------------------------------------
APP_ENV=development
APP_NAME=ASEP
APP_VERSION=0.1.0
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
APP_WORKERS=1

# --------------------------------------------------
# Security & Authentication
# --------------------------------------------------
SECRET_KEY=change-this-to-a-random-256-bit-secret
JWT_SECRET_KEY=change_me_in_production
JWT_REFRESH_SECRET_KEY=change_me_in_production_refresh
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

ENABLE_TURNSTILE=false
TURNSTILE_SECRET_KEY=

# --------------------------------------------------
# Databases & Caching
# --------------------------------------------------
# PostgreSQL Connection URL
DATABASE_URL=postgresql+asyncpg://asep:changeme@localhost:5432/asep

# Redis Connection URL
REDIS_URL=redis://localhost:6379/0

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=asep_documents
QDRANT_VECTOR_SIZE=1536

# --------------------------------------------------
# AI / LLM Providers & Models
# --------------------------------------------------
# Google Gemini Free API
GEMINI_API_KEY=

# Ollama / Local Models
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# Custom OpenAI-Compatible Embedding / LLM Endpoints
EMBEDDING_API_URL=http://localhost:11434/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
LLM_API_URL=http://localhost:11434/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=qwen2.5-coder:7b

# --------------------------------------------------
# Cloud Storage & File Uploads (Cloudinary)
# --------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# --------------------------------------------------
# Observability & Error Tracking
# --------------------------------------------------
SENTRY_DSN_BACKEND=

# --------------------------------------------------
# Monetization (Razorpay)
# --------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --------------------------------------------------
# OAuth Providers
# --------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/github/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# --------------------------------------------------
# CORS & Networking
# --------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
FRONTEND_URL=http://localhost:3000
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Email / SMTP Settings
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@asep.local
RESEND_API_KEY=

