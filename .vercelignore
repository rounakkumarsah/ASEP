# .vercelignore
# Keep Vercel deployments small and fast by ignoring test, cache, and dev files.

# Git and GitHub
.git/
.github/

# Caches and logs
.pytest_cache/
backend/.pytest_cache/
.ruff_cache/
backend/.ruff_cache/
.mypy_cache/
backend/.mypy_cache/
logs/
backend/logs/
*.log

# Coverage reports
htmlcov/
backend/htmlcov/
.coverage
backend/.coverage

# Dependencies and build directories
node_modules/
frontend/node_modules/
.next/
frontend/.next/
dist/
build/
*.egg-info/
__pycache__/
backend/**/__pycache__/

# Benchmarks
benchmarks/results/
